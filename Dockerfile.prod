FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG REACT_APP_URL_API=https://cms.garudaorganizer.com/api/
ARG REACT_APP_URL_API_KEY
ARG REACT_APP_URL_IMG=https://cms.garudaorganizer.com/
ARG REACT_APP_MAINTENANCE=false

ENV REACT_APP_URL_API=${REACT_APP_URL_API} \
    REACT_APP_URL_API_KEY=${REACT_APP_URL_API_KEY} \
    REACT_APP_URL_IMG=${REACT_APP_URL_IMG} \
    REACT_APP_MAINTENANCE=${REACT_APP_MAINTENANCE}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
